\subsection{Метод половинного деления}

\textbf{Идея метода:} начальный интервал изоляции корня делится пополам, и в качестве нового интервала выбирается та половина, на концах которой функция имеет разные знаки.

\textbf{Рабочая формула метода:}
\begin{equation}
    x_i = \frac{a_i + b_i}{2}
\end{equation}

\textbf{Критерий окончания итерационного процесса:}
\begin{equation}
    |a_n - b_n| \leq \varepsilon \quad \text{или} \quad |f(x_n)| \leq \varepsilon
\end{equation}

\textbf{Приближенное значение корня:}
\begin{equation}
    x^* = \frac{a_n + b_n}{2} \quad \text{или} \quad x^* = a_n \quad \text{или} \quad x^* = b_n
\end{equation}

