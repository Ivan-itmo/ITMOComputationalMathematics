\section{Рабочие формулы используемых методов}

\subsection{Метод хорд}

\textbf{Рабочая формула метода:}
\begin{equation}
    x_i = a_i - \frac{b_i - a_i}{f(b_i) - f(a_i)} \cdot f(a_i)
\end{equation}
или эквивалентная форма:
\begin{equation}
    x_i = \frac{a_i f(b_i) - b_i f(a_i)}{f(b_i) - f(a_i)}
\end{equation}

