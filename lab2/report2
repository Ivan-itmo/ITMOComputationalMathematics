\subsection{Метод простой итерации для систем нелинейных уравнений}

\textbf{Постановка задачи:} Дана система нелинейных уравнений:
\begin{equation}
    \begin{cases}
        F_1(x_1, x_2, \ldots, x_n) = 0 \\
        F_2(x_1, x_2, \ldots, x_n) = 0 \\
        \ldots\ldots\ldots\ldots\ldots\ldots\ldots\ldots\ldots \\
        F_n(x_1, x_2, \ldots, x_n) = 0
    \end{cases}
\end{equation}

\textbf{Идея метода:} Привести систему к эквивалентному виду $X = \varphi(X)$ и строить итерационную последовательность приближений.

\textbf{Приведение системы к итерационному виду:}
\begin{equation}
    \begin{cases}
        x_1 = \varphi_1(x_1, x_2, \ldots, x_n) \\
        x_2 = \varphi_2(x_1, x_2, \ldots, x_n) \\
        \ldots\ldots\ldots\ldots\ldots\ldots\ldots\ldots\ldots \\
        x_n = \varphi_n(x_1, x_2, \ldots, x_n)
    \end{cases}
\end{equation}

Или в векторной форме:
\begin{equation}
    X = \varphi(X), \quad \text{где } \varphi(X) = \begin{pmatrix} \varphi_1(X) \\ \varphi_2(X) \\ \vdots \\ \varphi_n(X) \end{pmatrix}
\end{equation}

\textbf{Рабочая формула метода:}
\begin{equation}
    X^{(k+1)} = \varphi(X^{(k)}), \quad k = 0, 1, 2, \ldots
\end{equation}

\textbf{Для системы второго порядка:}
\begin{equation}
    \begin{cases}
        x_{k+1} = \varphi_1(x_k, y_k) \\
        y_{k+1} = \varphi_2(x_k, y_k)
    \end{cases}
\end{equation}

