\subsection{Метод Ньютона для систем нелинейных уравнений}

\textbf{Постановка задачи:} Дана система нелинейных уравнений:
\begin{equation}
    \begin{cases}
        F_1(x_1, x_2, \ldots, x_n) = 0 \\
        F_2(x_1, x_2, \ldots, x_n) = 0 \\
        \ldots\ldots\ldots\ldots\ldots\ldots\ldots\ldots\ldots \\
        F_n(x_1, x_2, \ldots, x_n) = 0
    \end{cases}
\end{equation}

\textbf{Идея метода:} Линеаризация системы с помощью разложения в ряд Тейлора и решения системы линейных уравнений относительно приращений.

\textbf{Матрица Якоби:}
\begin{equation}
    J(x) = \begin{pmatrix}
        \frac{\partial F_1}{\partial x_1} & \frac{\partial F_1}{\partial x_2} & \cdots & \frac{\partial F_1}{\partial x_n} \\
        \frac{\partial F_2}{\partial x_1} & \frac{\partial F_2}{\partial x_2} & \cdots & \frac{\partial F_2}{\partial x_n} \\
        \vdots & \vdots & \ddots & \vdots \\
        \frac{\partial F_n}{\partial x_1} & \frac{\partial F_n}{\partial x_2} & \cdots & \frac{\partial F_n}{\partial x_n}
    \end{pmatrix}
\end{equation}

\textbf{Рабочая формула метода:}
\begin{equation}
    J(\vec{x}^{(k)}) \cdot \Delta\vec{x}^{(k)} = -\vec{F}(\vec{x}^{(k)})
\end{equation}
\begin{equation}
    \vec{x}^{(k+1)} = \vec{x}^{(k)} + \Delta\vec{x}^{(k)}
\end{equation}

\textbf{Для системы второго порядка:}
\begin{equation}
    \begin{cases}
        f(x, y) = 0 \\
        g(x, y) = 0
    \end{cases}
\end{equation}

Матрица Якоби:
\begin{equation}
    J(x, y) = \begin{pmatrix}
        \frac{\partial f}{\partial x} & \frac{\partial f}{\partial y} \\
        \frac{\partial g}{\partial x} & \frac{\partial g}{\partial y}
    \end{pmatrix}
\end{equation}

Система линейных уравнений для нахождения приращений:
\begin{equation}
    \begin{pmatrix}
        \frac{\partial f}{\partial x} & \frac{\partial f}{\partial y} \\
        \frac{\partial g}{\partial x} & \frac{\partial g}{\partial y}
    \end{pmatrix}
    \begin{pmatrix}
        \Delta x \\
        \Delta y
    \end{pmatrix}
    =
    \begin{pmatrix}
        -f(x, y) \\
        -g(x, y)
    \end{pmatrix}
\end{equation}

\textbf{Итерационные формулы:}
\begin{equation}
    x_{k+1} = x_k + \Delta x_k, \quad y_{k+1} = y_k + \Delta y_k
\end{equation}

