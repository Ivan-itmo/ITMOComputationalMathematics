\subsection{Метод секущих}

\textbf{Рабочая формула метода:}
\begin{equation}
    x_{i+1} = x_i - \frac{x_i - x_{i-1}}{f(x_i) - f(x_{i-1})} \cdot f(x_i), \quad i = 1, 2, \ldots
\end{equation}

\textbf{Критерий окончания итерационного процесса:}
\begin{equation}
    |x_n - x_{n-1}| \leq \varepsilon \quad \text{или} \quad |f(x_n)| \leq \varepsilon
\end{equation}

\textbf{Приближенное значение корня:} $x^* = x_n$

