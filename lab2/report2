package solver;

import functions.Systems;

public class SystemSolver {
    public static Result[] simpleIteration(int sysIndex, double x0, double y0, double epsilon, int maxIterations) {
        double x = x0;
        double y = y0;
        int iterations = 0;
        double deltaX = 0;
        double deltaY = 0;
        for (int i = 0; i < maxIterations; i++) {
            double[] phi = Systems.evaluatePhi(sysIndex, x, y);
            double xNew = phi[0];
            double yNew = phi[1];
            iterations++;
            deltaX = Math.abs(xNew - x);
            deltaY = Math.abs(yNew - y);
            if (deltaX < epsilon && deltaY < epsilon) {
                return new Result[] {
                        new Result(xNew, deltaX, iterations, true, "Метод простой итерации (x)"),
                        new Result(yNew, deltaY, iterations, true, "Метод простой итерации (y)")
                };
            }
            x = xNew;
            y = yNew;
        }
        return new Result[] {
                new Result(x, deltaX, iterations, false, "Метод простой итерации (x)", "Превышено максимальное число итераций"),
                new Result(y, deltaY, iterations, false, "Метод простой итерации (y)", "Превышено максимальное число итераций")
        };
    }
}
