<mxfile host="app.diagrams.net">
  <diagram name="Метод хорд">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1"
    connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850"
    pageHeight="1100">
      <root>

        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="start" value="Начало"
        style="ellipse;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;"
        vertex="1" parent="1">
        <mxGeometry x="360" y="20" width="120" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="input" value="Ввести f(x), a₀, b₀, ε"
        style="rounded=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;"
        vertex="1" parent="1">
        <mxGeometry x="320" y="120" width="200" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="calcx"
        value="xᵢ = aᵢ - (bᵢ - aᵢ)/(f(bᵢ)-f(aᵢ)) · f(aᵢ)"
        style="rounded=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;"
        vertex="1" parent="1">
        <mxGeometry x="260" y="220" width="320" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="calcfx"
        value="Вычислить f(xᵢ)"
        style="rounded=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;"
        vertex="1" parent="1">
        <mxGeometry x="330" y="320" width="180" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="check"
        value="|xᵢ − xᵢ₋₁| ≤ ε или |f(xᵢ)| ≤ ε ?"
        style="rhombus;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;"
        vertex="1" parent="1">
        <mxGeometry x="300" y="420" width="240" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="update"
        value="f(aᵢ) · f(xᵢ) &lt; 0 ?"
        style="rhombus;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;"
        vertex="1" parent="1">
        <mxGeometry x="300" y="570" width="240" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="setb"
        value="bᵢ = xᵢ"
        style="rounded=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;"
        vertex="1" parent="1">
        <mxGeometry x="140" y="720" width="160" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="seta"
        value="aᵢ = xᵢ"
        style="rounded=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;"
        vertex="1" parent="1">
        <mxGeometry x="560" y="720" width="160" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="result"
        value="x* = xᵢ"
        style="rounded=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;"
        vertex="1" parent="1">
        <mxGeometry x="350" y="720" width="160" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="end"
        value="Конец"
        style="ellipse;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;"
        vertex="1" parent="1">
        <mxGeometry x="360" y="820" width="120" height="60" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>