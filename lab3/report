\section{Рабочие формулы методов}

\subsection{Метод левых прямоугольников}
\[
\int_a^b f(x)dx \approx h \sum_{i=0}^{n-1} f(x_i), \quad h = \frac{b-a}{n}, \quad x_i = a + i \cdot h
\]

\subsection{Метод правых прямоугольников}
\[
\int_a^b f(x)dx \approx h \sum_{i=1}^{n} f(x_i), \quad h = \frac{b-a}{n}, \quad x_i = a + i \cdot h
\]

\subsection{Метод средних прямоугольников}
\[
\int_a^b f(x)dx \approx h \sum_{i=1}^{n} f\left(x_{i-\frac{1}{2}}\right), \quad h = \frac{b-a}{n}, \quad x_{i-\frac{1}{2}} = a + \left(i - \frac{1}{2}\right) \cdot h
\]

\subsection{Метод трапеций}
\[
\int_a^b f(x)dx \approx h \left( \frac{f(a) + f(b)}{2} + \sum_{i=1}^{n-1} f(x_i) \right), \quad h = \frac{b-a}{n}, \quad x_i = a + i \cdot h
\]

\subsection{Метод Симпсона (парабол)}
\[
\int_a^b f(x)dx \approx \frac{h}{3} \left( f(a) + f(b) + 4 \sum_{i=1}^{n/2} f(x_{2i-1}) + 2 \sum_{i=1}^{n/2 - 1} f(x_{2i}) \right),
\]
\[
h = \frac{b-a}{n}, \quad n - \text{чётное}
\]

\subsection{Формула Ньютона–Котеса}
\[
\int_a^b f(x)dx \approx (b-a) \sum_{i=0}^{n} H_i^{(n)} f(x_i)
\]
где \( H_i^{(n)} \) — коэффициенты Котеса. Для \( n = 6 \) коэффициенты равны:
\[
H_0 = H_6 = \frac{41}{840}, \quad H_1 = H_5 = \frac{216}{840}, \quad H_2 = H_4 = \frac{27}{840}, \quad H_3 = \frac{272}{840}
\]

\subsection{Правило Рунге}
Правило Рунге используется для оценки погрешности численного интегрирования. Если \( I_h \) и \( I_{h/2} \) — приближённые значения интеграла, вычисленные с шагами \( h \) и \( h/2 \), а \( k \) — порядок точности метода (\( k = 2 \) для методов средних прямоугольников и трапеций, \( k = 4 \) для метода Симпсона), то погрешность оценивается по формуле:
\[
R \approx \frac{|I_{h/2} - I_h|}{2^k - 1}
\]
Вычислительный процесс завершается, когда \( R < \varepsilon \), где \( \varepsilon \) — заданная точность. При этом в качестве приближённого значения интеграла принимается \( I_{h/2} \).

