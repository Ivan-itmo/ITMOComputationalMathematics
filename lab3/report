\section{Листинг программы}

Программа реализована на языке Java. Основные классы и методы:

\subsection{Класс Integrator}
Главный класс, содержащий методы численного интегрирования.

\begin{lstlisting}[language=Java, caption=Класс Integrator (основной)]
package integration;

import function.FunctionChoose;

public final class Integrator {
    private static final int maxPart = (int) Math.pow(2, 24);
    private static final int maxDeltaIterations = 60;

    private Integrator() {
    }

    public static IntegrationResult integrate(
            FunctionChoose function,
            double a,
            double b,
            IntegrationMethod method,
            double epsilon,
            int initialPartitions
    ) {
        if (a == b) {
            return new IntegrationResult(0.0, initialPartitions, 0.0);
        }

        double left = a;
        double right = b;
        if (a > b) {
            left = b;
            right = a;
        }

        FunctionChoose.SingularityCase singularityCase = function.whereGap(left, right);
        if (singularityCase != FunctionChoose.SingularityCase.NONE) {
            if (!function.isDesicion(left, right)) {
                throw new IllegalArgumentException("Интеграл не существует.");
            }
            return integrateImproper(function, a, b, method, epsilon, initialPartitions, singularityCase);
        }

        return integrateProper(function, a, b, method, epsilon, initialPartitions);
    }

    private static IntegrationResult integrateProper(
            FunctionChoose function,
            double a,
            double b,
            IntegrationMethod method,
            double epsilon,
            int initialPartitions
    ) {
        int sign = 1;
        double left = a;
        double right = b;
        if (a > b) {
            sign = -1;
            left = b;
            right = a;
        }

        IntegrationResult result = integrateProperDirect(function, left, right, method, epsilon, initialPartitions);
        return new IntegrationResult(sign * result.getValue(), result.getParts(), result.getErrorEpsilon());
    }

    private static IntegrationResult integrateProperDirect(
            FunctionChoose function,
            double left,
            double right,
            IntegrationMethod method,
            double epsilon,
            int initialPartitions
    ) {
        int n = initialPartitions;
        if (method == IntegrationMethod.SIMPSON && n % 2 != 0) {
            n++;
        }

        double previous = integrateChoose(function, left, right, n, method);

        while (n <= maxPart / 2) {
            int newN = n * 2;
            double current = integrateChoose(function, left, right, newN, method);
            double rungeError = Math.abs(current - previous) / (Math.pow(2, method.getOrder()) - 1);

            if (rungeError <= epsilon) {
                return new IntegrationResult(current, newN, rungeError);
            }

            n = newN;
            previous = current;
        }

        throw new IllegalArgumentException("Не удалось достичь заданной точности. Попробуйте увеличить epsilon.");
    }

    private static IntegrationResult integrateImproper(
            FunctionChoose function,
            double a,
            double b,
            IntegrationMethod method,
            double epsilon,
            int initialPartitions,
            FunctionChoose.SingularityCase singularityCase
    ) {
        int sign = 1;
        double left = a;
        double right = b;
        if (a > b) {
            sign = -1;
            left = b;
            right = a;
        }

        double intervalLength = right - left;
        Double singularPoint = function.getGapPoint();
        if (singularPoint == null) {
            throw new IllegalArgumentException("Точка разрыва не определена для несобственного интеграла.");
        }

        double delta = switch (singularityCase) {
            case AT_A, AT_B -> intervalLength / 4.0;
            case INSIDE -> Math.min(singularPoint - left, right - singularPoint) / 2.0;
            case NONE -> throw new IllegalStateException("Разрыв не обнаружен.");
        };
        if (!(delta > 0.0)) {
            throw new IllegalArgumentException("Некорректный интервал для несобственного интеграла.");
        }

        IntegrationResult previous = integrateImproperDelta(
                function, left, right, singularPoint, singularityCase, method, epsilon / 4.0, initialPartitions, delta
        );

        for (int i = 0; i < maxDeltaIterations; i++) {
            delta /= 2.0;
            IntegrationResult current = integrateImproperDelta(
                    function, left, right, singularPoint, singularityCase, method, epsilon / 4.0, initialPartitions, delta
            );

            double tailError = Math.abs(current.getValue() - previous.getValue());
            double totalError = tailError + current.getErrorEpsilon();
            if (totalError <= epsilon) {
                return new IntegrationResult(sign * current.getValue(), current.getParts(), totalError);
            }

            previous = current;
            if (delta <= Math.ulp(1.0) * Math.max(1.0, intervalLength)) {
                break;
            }
        }

        throw new IllegalArgumentException("Не удалось достичь заданной точности для несобственного интеграла.");
    }

    private static IntegrationResult integrateImproperDelta(
            FunctionChoose function,
            double left,
            double right,
            double singularPoint,
            FunctionChoose.SingularityCase singularityCase,
            IntegrationMethod method,
            double epsilon,
            int initialPartitions,
            double delta
    ) {
        return switch (singularityCase) {
            case AT_A -> integrateProperDirect(function, left + delta, right, method, epsilon, initialPartitions);
            case AT_B -> integrateProperDirect(function, left, right - delta, method, epsilon, initialPartitions);
            case INSIDE -> {
                IntegrationResult leftResult = integrateProperDirect(function, left, singularPoint - delta, method, epsilon / 2.0, initialPartitions);
                IntegrationResult rightResult = integrateProperDirect(function, singularPoint + delta, right, method, epsilon / 2.0, initialPartitions);
                double value = leftResult.getValue() + rightResult.getValue();
                int parts = Math.max(leftResult.getParts(), rightResult.getParts());
                double runge = leftResult.getErrorEpsilon() + rightResult.getErrorEpsilon();
                yield new IntegrationResult(value, parts, runge);
            }
            case NONE -> throw new IllegalStateException("Разрыв не обнаружен.");
        };
    }

    public static double integrateChoose(FunctionChoose function, double a, double b, int n, IntegrationMethod method) {
        if (n <= 0) {
            throw new IllegalArgumentException("Число разбиений должно быть положительным.");
        }

        return switch (method) {
            case LEFT_RECTANGLES -> leftRectangles(function, a, b, n);
            case RIGHT_RECTANGLES -> rightRectangles(function, a, b, n);
            case MIDDLE_RECTANGLES -> middleRectangles(function, a, b, n);
            case TRAPEZOID -> trapezoid(function, a, b, n);
            case SIMPSON -> simpson(function, a, b, n);
        };
    }

    private static double leftRectangles(FunctionChoose function, double a, double b, int n) {
        double h = (b - a) / n;
        double sum = 0.0;
        for (int i = 0; i < n; i++) {
            sum += function.calculate(a + i * h);
        }
        return sum * h;
    }

    private static double rightRectangles(FunctionChoose function, double a, double b, int n) {
        double h = (b - a) / n;
        double sum = 0.0;
        for (int i = 1; i <= n; i++) {
            sum += function.calculate(a + i * h);
        }
        return sum * h;
    }

    private static double middleRectangles(FunctionChoose function, double a, double b, int n) {
        double h = (b - a) / n;
        double sum = 0.0;
        for (int i = 0; i < n; i++) {
            sum += function.calculate(a + (i + 0.5) * h);
        }
        return sum * h;
    }

    private static double trapezoid(FunctionChoose function, double a, double b, int n) {
        double h = (b - a) / n;
        double sum = (function.calculate(a) + function.calculate(b)) / 2.0;
        for (int i = 1; i < n; i++) {
            sum += function.calculate(a + i * h);
        }
        return sum * h;
    }

    private static double simpson(FunctionChoose function, double a, double b, int n) {
        if (n % 2 != 0) {
            throw new IllegalArgumentException("Для метода Симпсона число разбиений должно быть четным.");
        }

        double h = (b - a) / n;
        double sum = function.calculate(a) + function.calculate(b);

        for (int i = 1; i < n; i++) {
            double coefficient = (i % 2 == 0) ? 2.0 : 4.0;
            sum += coefficient * function.calculate(a + i * h);
        }

        return sum * h / 3.0;
    }
}
\end{lstlisting}

